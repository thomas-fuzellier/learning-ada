with "config/lesson_01_config.gpr";
project Lesson_01 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Lesson_01_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("lesson_01.adb", "ex01_banner.adb", "ex02_mission_brief");

   package Compiler is
      for Default_Switches ("Ada") use Lesson_01_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Lesson_01;
