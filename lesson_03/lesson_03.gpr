with "config/lesson_03_config.gpr";
project Lesson_03 is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Lesson_03_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("lesson_03.adb", "ex01_flight_limits.adb", "ex02_track_status.adb", "ex03_radar_heading.adb", "ex04_sensor_types.adb", "ex05_missile_counter.adb");

   package Compiler is
      for Default_Switches ("Ada") use Lesson_03_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Lesson_03;
